{
    // Ctrl+Shift+B: compile the open .cpp file and run it
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build & run",
            "type": "shell",
            "command": "g++ -std=c++20 -Wall -Wextra -g '${file}' -o '${fileDirname}\\${fileBasenameNoExtension}.exe'; if ($?) { & '${fileDirname}\\${fileBasenameNoExtension}.exe' }",
            "options": {
                "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc",
            "presentation": { "clear": true }
        }
    ]
}
